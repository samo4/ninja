choice BOOTLOADER
	default BOOTLOADER_MCUBOOT if !BOARD_NATIVE_SIM && !BOARD_THINGY91_NRF9160_NS && !BOARD_SHADOW_NRF9160_NS
endchoice

# Skip the board's own MCUboot default (see thingy91/Kconfig.sysbuild) so the
# choice above falls through to BOOTLOADER_NONE for this target: no OTA, no
# swap slots, application runs directly after TF-M.
config THINGY91_NO_PREDEFINED_LAYOUT
	bool
	default y if BOARD_THINGY91_NRF9160_NS

config SECURE_BOOT_APPCORE
	default y if BOARD_NRF9151DK_NRF9151_NS

# Shared NSIB (b0) signing key for all ATT sysbuild targets. Sysbuild signs images with this
# key; b0 verifies them. Without this, sysbuild autogenerates a new debug key on each pristine
# build. Not for production.
config SECURE_BOOT_SIGNING_KEY_FILE
	default "$(ZEPHYR_NRF_MODULE_DIR)/boards/nordic/thingy91x/nsib_signing_key.pem" if SECURE_BOOT_APPCORE

config WIFI_NRF70
	default y if BOARD_THINGY91X_NRF9151_NS

choice WIFI_NRF70_OPER_MODES
	default WIFI_NRF70_SCAN_ONLY if BOARD_THINGY91X_NRF9151_NS
endchoice

config PARTITION_MANAGER
	default n

source "${ZEPHYR_BASE}/share/sysbuild/Kconfig"
