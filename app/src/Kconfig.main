menu "App"

choice APP_PERSONALITY
	prompt "Application personality"
	help
	  Select the application's behaviour profile.
	  Each personality implements a different orchestration
	  strategy using the same set of hardware modules.

config APP_PERSONALITY_REPORTING
	bool "Cloud Reporting"
	help
	  Standard periodic sampling of environmental sensors and
	  location, followed by cloud posting.  This is the default
	  behaviour.

config APP_PERSONALITY_LOW_POWER_TEST
	bool "Low Power Test"
	help
	  Measure environmental sensors → post to cloud → disconnect
	  LTE → sleep with modem off → repeat.  Half as many
	  measurements as the Cloud Reporting personality, but
	  provides a modem-off window during which board-level
	  power consumption can be measured with everything idle.

config APP_PERSONALITY_LOCATION_TEST
	bool "Location Test"
	depends on LOCATION
	help
	  Request GNSS fix → post to cloud → disconnect LTE →
	  sleep with modem off → repeat.  Reuses cloud_post for
	  HTTP.  If no location is found, sends an empty POST.

config APP_PERSONALITY_EMPTY
	bool "Empty"
	depends on APP_CLOUD_POST
	help
	  Same flow as Location Test, but instead of requesting location
	  data it immediately publishes an empty location package to
	  cloud_post.  Runs once: connect → send → disconnect → sleep
	  forever.  Useful as a power measurement baseline that still
	  exercises the full LTE + cloud path.

endchoice

config APP_SAMPLING_INTERVAL_SECONDS
	int "Sampling interval"
	default 600
	help
	  Interval in seconds that determines how often sensor and location data is
	  collected.

config APP_WATCHDOG_TIMEOUT_SECONDS
	int "Watchdog timeout"
	default 180
	help
	  Timeout in seconds for the main module watchdog.
	  The timeout given in this option covers both:
	    * Waiting for an incoming message in zbus_sub_wait_msg().
	    * Time spent processing the message, defined by
	      CONFIG_APP_MSG_PROCESSING_TIMEOUT_SECONDS.
	  Ensure that this value exceeds CONFIG_APP_MSG_PROCESSING_TIMEOUT_SECONDS.
	  A small difference between the two can mean more frequent watchdog feeds, which increases
	  power consumption.

config APP_MSG_PROCESSING_TIMEOUT_SECONDS
	int "Maximum message processing time"
	default 120
	help
	  Maximum time allowed for processing a single message in the module's state machine.
	  The value must be smaller than CONFIG_APP_WATCHDOG_TIMEOUT_SECONDS.

# ── Shared cloud server settings ──────────────────────────────────────────
# Both cloud_post and location_cloud modules use the same server.

config APP_CLOUD_HOST
	string "Cloud server hostname"
	default "balirkaback.azurewebsites.net"
	help
	  Hostname of the cloud REST API server.

config APP_CLOUD_PORT
	int "Cloud server port"
	default 80
	range 1 65535
	help
	  Port of the cloud REST API server.

config APP_CLOUD_USE_TLS
	bool "Use TLS for cloud server connection"
	default n
	help
	  Enable TLS (HTTPS) for connections to the cloud REST API server.
	  When disabled, plain HTTP is used (port 80, no security tag).

config APP_CLOUD_SEC_TAG
	int "Cloud server TLS security tag"
	depends on APP_CLOUD_USE_TLS
	default 168448
	help
	  Security tag for TLS connection to the cloud REST API server.
	  The corresponding CA certificate must be provisioned.

module = APP
module-str = APP
source "subsys/logging/Kconfig.template.log_config"

endmenu
