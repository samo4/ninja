menuconfig APP_CLOUD_POST
	bool "Cloud POST module"
	depends on REST_CLIENT
	default y
	help
	  Module that collects modem battery voltage and sensor data and
	  sends it as a CSV POST request to a configurable HTTP endpoint.

if APP_CLOUD_POST

config APP_CLOUD_POST_URL
	string "API URL path"
	default "/api/Ninja"
	help
	  URL path of the REST API endpoint.

config APP_CLOUD_POST_THREAD_STACK_SIZE
	int "Thread stack size"
	default 8192

module = APP_CLOUD_POST
module-str = Cloud POST
source "subsys/logging/Kconfig.template.log_config"

endif # APP_CLOUD_POST
