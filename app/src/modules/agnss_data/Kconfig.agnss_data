menuconfig APP_AGNSS_DATA
	bool "A-GNSS data module"
	depends on LOCATION
	help
	  Module that handles A-GNSS (Assisted GNSS) assistance requests from
	  the location library. When the GNSS subsystem needs assistance data
	  (ephemerides, almanacs, UTC parameters, etc.), this module fetches
	  the data from a configurable HTTP endpoint (proxy server) and feeds
	  it back to the GNSS subsystem via location_agnss_data_process().

	  This module is designed as a drop-in alternative to nRF Cloud's
	  A-GNSS handling. When enabled, it handles LOCATION_AGNSS_REQUEST
	  messages from the location module independently of nRF Cloud.

if APP_AGNSS_DATA

config APP_AGNSS_DATA_HOST
	string "AGNSS proxy hostname"
	default "balirkaback.azurewebsites.net"
	help
	  Hostname of the A-GNSS proxy server that provides assistance data.

config APP_AGNSS_DATA_PORT
	int "AGNSS proxy port"
	default 443
	range 1 65535
	help
	  Port of the A-GNSS proxy server.

config APP_AGNSS_DATA_URL
	string "AGNSS proxy URL path"
	default "/api/agnss"
	help
	  URL path of the A-GNSS proxy endpoint.
	  The A-GNSS request parameters will be sent to this endpoint.

config APP_AGNSS_DATA_SEC_TAG
	int "AGNSS proxy TLS security tag"
	default 168448
	help
	  Security tag for TLS connection to the A-GNSS proxy server.
	  The corresponding CA certificate must be provisioned.

config APP_AGNSS_DATA_BUFFER_SIZE
	int "AGNSS response buffer size"
	default 3800
	help
	  Maximum size of the A-GNSS data response buffer.
	  The default 3800 bytes matches the nRF Cloud AGNSS data size.

config APP_AGNSS_DATA_THREAD_STACK_SIZE
	int "Thread stack size"
	default 8192
	help
	  Stack size for the A-GNSS data module thread.

config APP_AGNSS_DATA_WATCHDOG_TIMEOUT_SECONDS
	int "Watchdog timeout"
	default 120
	help
	  Timeout in seconds for the A-GNSS data module watchdog.

config APP_AGNSS_DATA_MSG_PROCESSING_TIMEOUT_SECONDS
	int "Maximum message processing time"
	default 60
	help
	  Maximum time allowed for processing a single message.

module = APP_AGNSS_DATA
module-str = A-GNSS data
source "subsys/logging/Kconfig.template.log_config"

endif # APP_AGNSS_DATA
